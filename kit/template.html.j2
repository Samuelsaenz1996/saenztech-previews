<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{{ b.business }} — {{ t('Concepto de diseño','Design concept') }}</title>
<meta property="og:title" content="{{ b.business }} — {{ t('Concepto de diseño por Saenztech','Design concept by Saenztech') }}">
<meta property="og:image" content="preview.png">
<style>
{{ fontfaces|safe }}
:root{ {% for k,v in th.colors.items() %}--{{k}}:{{v}};{% endfor %} }
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:"{{ th.body_font }}",system-ui,sans-serif;color:var(--ink);background:var(--bg);line-height:1.55;-webkit-font-smoothing:antialiased}
h1,h2,h3,.logo{font-family:"{{ th.head_font }}","{{ th.body_font }}",serif;line-height:1.06;letter-spacing:{{ th.tracking }}}
a{color:inherit}
.wrap{max-width:1080px;margin:0 auto;padding:0 20px}
.ribbon{background:var(--ink);color:var(--bg);font-size:12.5px;text-align:center;padding:7px 16px;opacity:.96}
.ribbon b{color:var(--accent2);font-weight:600}
.deco{height:{{ '30px' if th.deco=='picado' else '6px' }};display:flex;gap:{{ '4px' if th.deco=='picado' else '0' }};padding:0 {{ '2px' if th.deco=='picado' else '0' }}}
.deco span{flex:1}
{% if th.deco=='picado' %}
.deco span{height:30px;clip-path:polygon(0 0,100% 0,100% 72%,85% 100%,70% 72%,50% 100%,30% 72%,15% 100%,0 72%);-webkit-mask:radial-gradient(circle at 50% 40%,transparent 4px,#000 5px);mask:radial-gradient(circle at 50% 40%,transparent 4px,#000 5px)}
{% endif %}
.deco span:nth-child(4n+1){background:var(--accent)}
.deco span:nth-child(4n+2){background:var(--accent2)}
.deco span:nth-child(4n+3){background:var(--accent3)}
.deco span:nth-child(4n+4){background:var(--accent4)}
nav{display:flex;align-items:center;justify-content:space-between;padding:16px 0;gap:12px}
.logo{font-weight:{{ th.head_weight }};font-size:26px;color:var(--accent)}
.logo small{display:block;font-family:"{{ th.body_font }}",sans-serif;font-weight:500;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-top:4px}
.lang{display:flex;border:1.5px solid var(--ink);border-radius:999px;overflow:hidden;flex-shrink:0}
.lang button{border:0;background:transparent;font:600 13px "{{ th.body_font }}",sans-serif;padding:7px 12px;cursor:pointer;color:var(--ink)}
.lang button.on{background:var(--ink);color:var(--bg)}
.hero{display:grid;gap:28px;padding:18px 0 44px;align-items:center}
.eyebrow{display:inline-flex;gap:8px;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:999px;padding:6px 12px;font-size:13px;font-weight:600}
.dot{width:8px;height:8px;border-radius:50%;background:var(--accent3)}
.hero h1{font-size:clamp(42px,8.5vw,80px);font-weight:{{ th.head_weight }};margin:16px 0 14px}
.hero h1 em{font-style:{{ th.em_style }};color:var(--accent)}
.hero p.lead{font-size:18px;color:var(--muted);max-width:30em}
.ctas{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}
.ctas .btn{flex:1 1 auto;justify-content:center}
.btn{display:inline-flex;align-items:center;gap:8px;text-decoration:none;font-weight:600;font-size:16px;padding:14px 20px;border-radius:{{ th.radius }};border:2px solid var(--ink)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff;box-shadow:0 4px 0 var(--accent-dark)}
.btn.ghost{background:var(--card)}
.btn svg{width:18px;height:18px}
.photo{position:relative;border-radius:22px;aspect-ratio:4/3;overflow:hidden;background:repeating-linear-gradient(135deg,var(--ph1) 0 18px,var(--ph2) 18px 36px);border:2px dashed var(--ph3);display:grid;place-items:center;text-align:center;color:var(--ph-ink);font-weight:600;font-size:14px}
.photo .tag{background:rgba(255,255,255,.85);padding:8px 14px;border-radius:999px}
.hero .photo{transform:rotate({{ th.tilt }})}
.rating{display:flex;align-items:center;gap:10px;margin-top:22px;font-size:14px;color:var(--muted)}
.stars{color:var(--star,var(--accent2));letter-spacing:2px;font-size:18px}
section{padding:56px 0}
.sec-head{display:flex;justify-content:space-between;align-items:end;gap:16px;margin-bottom:24px;flex-wrap:wrap}
.sec-head h2{font-size:clamp(32px,5vw,46px);font-weight:{{ th.head_weight }}}
.sec-head p{color:var(--muted);max-width:28em}
.items{display:grid;gap:16px}
.item{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:18px;display:grid;grid-template-columns:{{ '96px 1fr' if th.item_photos else '1fr' }};gap:16px;align-items:center}
.item .photo{aspect-ratio:1;border-radius:14px;font-size:11px}
.item h3{font-size:22px;font-weight:{{ th.head_weight }}}
.item p{color:var(--muted);font-size:14.5px;margin-top:4px}
.price{font-weight:600;color:var(--accent);margin-top:6px;font-size:14px}
.item.placeholder{background:transparent;border-style:dashed}
.item.placeholder h3{color:var(--ph-ink)}
.band{background:var(--band);color:#fff}
.band .wrap{display:grid;gap:22px}
.band h2{font-size:clamp(28px,4.5vw,40px);font-weight:{{ th.head_weight }}}
.chips{display:flex;flex-wrap:wrap;gap:10px}
.chip{background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.35);border-radius:999px;padding:9px 15px;font-weight:500}
.band small{opacity:.85;font-size:13px}
.info{display:grid;gap:18px}
.card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:24px}
.card h3{font-size:24px;font-weight:{{ th.head_weight }};margin-bottom:14px}
.hours{list-style:none}
.hours li{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--line)}
.hours li:last-child{border:0}
.hours li.today{font-weight:600;color:var(--accent)}
.map{display:grid;place-items:center;margin-top:14px;border-radius:14px;aspect-ratio:16/9;text-decoration:none;background:linear-gradient(90deg,transparent 48%,var(--line) 48% 52%,transparent 52%),linear-gradient(0deg,transparent 46%,var(--line) 46% 54%,transparent 54%),linear-gradient(30deg,transparent 60%,var(--ph1) 60% 63%,transparent 63%),var(--bg)}
.pin{background:var(--accent);color:#fff;font-weight:600;font-size:13px;padding:8px 12px;border-radius:12px;box-shadow:0 6px 16px rgba(0,0,0,.15)}
.note{font-size:12.5px;color:var(--muted);margin-top:10px}
.contact p{margin-bottom:8px}
footer{background:var(--ink);color:var(--bg);padding:36px 0 90px;font-size:14px}
footer .wrap{display:grid;gap:10px}
footer .logo{color:var(--accent2)}
footer .concept{border-top:1px solid rgba(255,255,255,.15);margin-top:12px;padding-top:14px;font-size:12.5px;opacity:.75}
.callbar{position:fixed;left:12px;right:12px;bottom:12px;display:flex;gap:10px;z-index:5}
.callbar a{flex:1;justify-content:center}
@media (min-width:820px){
  .hero{grid-template-columns:1.1fr .9fr;padding:40px 0 70px}
  .items{grid-template-columns:repeat(2,1fr)}
  .band .wrap{grid-template-columns:1fr 1.2fr;align-items:center}
  .info{grid-template-columns:1fr 1fr}
  .callbar{display:none}
  footer{padding-bottom:36px}
}
{% if bilingual %}
[data-{{ alt }}]{display:none!important}
html[lang={{ alt }}] [data-{{ lang }}]{display:none!important}
html[lang={{ alt }}] [data-{{ alt }}]{display:revert!important}
html[lang={{ alt }}] .logo small[data-{{ alt }}]{display:block!important}
{% endif %}
</style>
</head>
<body>
{% macro L(v) -%}
{%- if v is mapping -%}
{%- if bilingual -%}<span data-es>{{ v.es|safe }}</span><span data-en>{{ v.en|safe }}</span>{%- else -%}{{ v[lang]|safe }}{%- endif -%}
{%- else -%}{{ v|safe }}{%- endif -%}
{%- endmacro %}
{% set phone_svg %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>{% endset %}
{% set pin_svg %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>{% endset %}
{% set cal_svg %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></svg>{% endset %}

<div class="ribbon">{{ L({'es':'<b>Concepto de diseño</b> por Saenztech · no es el sitio oficial de '~b.business,'en':'<b>Design concept</b> by Saenztech · not the official site of '~b.business}) }}</div>
<div class="deco" aria-hidden="true">{% for i in range(16) %}<span></span>{% endfor %}</div>

<div class="wrap">
  <nav>
    <div class="logo">{{ b.business }}<small>{{ L(b.subtitle) }}</small></div>
    {% if bilingual %}<div class="lang" role="group" aria-label="Idioma / Language"><button class="{{ 'on' if lang=='es' }}" data-set="es">ES</button><button class="{{ 'on' if lang=='en' }}" data-set="en">EN</button></div>{% endif %}
  </nav>
  <header class="hero">
    <div>
      {% if b.eyebrow %}<span class="eyebrow"><span class="dot"></span>{{ L(b.eyebrow) }}</span>{% endif %}
      <h1>{{ L(b.headline) }}</h1>
      <p class="lead">{{ L(b.lead) }}</p>
      <div class="ctas">
        {% if b.booking_url %}
        <a class="btn primary" href="{{ b.booking_url }}" target="_blank" rel="noopener">{{ cal_svg|safe }}{{ L(b.booking_label or th.labels.book) }}</a>
        {% if b.phone %}<a class="btn ghost" href="tel:{{ b.phone }}">{{ phone_svg|safe }}{{ b.phone_display }}</a>{% endif %}
        {% else %}
        {% if b.phone %}<a class="btn primary" href="tel:{{ b.phone }}">{{ phone_svg|safe }}{{ b.phone_display }}</a>{% endif %}
        {% if b.address %}<a class="btn ghost" href="{{ maps }}" target="_blank" rel="noopener">{{ pin_svg|safe }}{{ L(th.labels.directions) }}</a>{% elif b.secondary_url %}<a class="btn ghost" href="{{ b.secondary_url }}" target="_blank" rel="noopener">{{ L(b.secondary_label) }}</a>{% endif %}
        {% endif %}
      </div>
      {% if b.rating %}<div class="rating"><span class="stars">★★★★★</span>{{ L({'es': b.rating.value|string ~ ' de ' ~ b.rating.count|string ~ ' reseñas en ' ~ b.rating.source, 'en': b.rating.value|string ~ ' from ' ~ b.rating.count|string ~ ' reviews on ' ~ b.rating.source}) }}</div>{% endif %}
    </div>
    <div class="photo"><span class="tag">{{ L(b.photo_label or th.labels.photo) }}</span></div>
  </header>
</div>

<section id="items">
  <div class="wrap">
    <div class="sec-head"><h2>{{ L(b.items_title or th.labels.items_title) }}</h2><p>{{ L(b.items_note or th.labels.items_note) }}</p></div>
    <div class="items">
      {% for it in b['items'] %}
      <div class="item">{% if th.item_photos %}<div class="photo">{{ L(th.labels.photo_short) }}</div>{% endif %}<div><h3>{{ L(it.name) }}</h3>{% if it.desc %}<p>{{ L(it.desc) }}</p>{% endif %}{% if th.show_price %}<div class="price">{{ it.price or '$ —' }}</div>{% endif %}</div></div>
      {% endfor %}
      {% for ph in placeholders %}
      <div class="item placeholder">{% if th.item_photos %}<div class="photo">+</div>{% endif %}<div><h3>{{ L(ph.name) }}</h3><p>{{ L(ph.desc) }}</p></div></div>
      {% endfor %}
    </div>
  </div>
</section>

{% if b.themes %}
<section class="band">
  <div class="wrap">
    <div><h2>{{ L(th.labels.reviews_title) }}</h2><small>{{ L(th.labels.reviews_note) }}</small></div>
    <div class="chips">{% for c in b.themes %}<span class="chip">{{ L(c) }}</span>{% endfor %}</div>
  </div>
</section>
{% endif %}

<section id="visit">
  <div class="wrap info">
    <div class="card">
      {% if b.hours %}
      <h3>{{ L(th.labels.hours) }}</h3>
      <ul class="hours">{% for h in b.hours %}<li data-day="{{ h.day }}"><span>{{ L({'es':h.es,'en':h.en}) }}</span><span>{{ h.time }}</span></li>{% endfor %}</ul>
      <p class="note">{{ L(th.labels.hours_note) }}</p>
      {% else %}
      <h3>{{ L(th.labels.contact) }}</h3>
      <div class="contact">
        {% if b.phone %}<p><a href="tel:{{ b.phone }}">{{ b.phone_display }}</a></p>{% endif %}
        {% if b.service_area %}<p>{{ L(b.service_area) }}</p>{% endif %}
        {% if b.booking_url %}<p><a href="{{ b.booking_url }}" target="_blank" rel="noopener">{{ L(b.booking_label or th.labels.book) }} →</a></p>{% endif %}
        <p class="note">{{ L(th.labels.hours_note) }}</p>
      </div>
      {% endif %}
    </div>
    <div class="card">
      <h3>{{ L(th.labels.find_us) }}</h3>
      {% if b.address %}<p>{{ b.address }}</p>
      <a class="map" href="{{ maps }}" target="_blank" rel="noopener" aria-label="Google Maps"><span class="pin">📍 {{ b.business }}</span></a>
      {% else %}<p>{{ L(b.service_area or {'es':'Área de servicio por confirmar','en':'Service area to be confirmed'}) }}</p>
      <div class="map"><span class="pin">{{ b.city }}</span></div>{% endif %}
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <div class="logo">{{ b.business }}</div>
    <div>{% if b.address %}{{ b.address }}{% else %}{{ b.city }}{% endif %}{% if b.phone %} · <a href="tel:{{ b.phone }}">{{ b.phone_display }}</a>{% endif %}</div>
    <div class="concept">{{ L({'es':'Este es un concepto de diseño preparado por Saenztech (saenz-tech.com) para mostrarle a '~b.business~' cómo podría verse su sitio. No es el sitio oficial del negocio. Fotos, precios y textos se definen con el dueño.','en':'This is a design concept prepared by Saenztech (saenz-tech.com) to show '~b.business~' what their site could look like. It is not the business\'s official site. Photos, prices and copy are finalized with the owner.'}) }}</div>
  </div>
</footer>

{% if b.phone or b.booking_url %}
<div class="callbar">
  {% if b.booking_url %}<a class="btn primary" href="{{ b.booking_url }}" target="_blank" rel="noopener">{{ L(b.booking_label or th.labels.book) }}</a>{% endif %}
  {% if b.phone %}<a class="btn {{ 'ghost' if b.booking_url else 'primary' }}" href="tel:{{ b.phone }}">{{ L(th.labels.call) }}</a>{% endif %}
  {% if b.address and not b.booking_url %}<a class="btn ghost" href="{{ maps }}" target="_blank" rel="noopener">{{ L(th.labels.directions) }}</a>{% endif %}
</div>
{% endif %}

<script>
document.querySelectorAll('.lang button').forEach(b=>b.addEventListener('click',()=>{document.documentElement.lang=b.dataset.set;document.querySelectorAll('.lang button').forEach(x=>x.classList.toggle('on',x===b));}));
const d=new Date().getDay();document.querySelectorAll('.hours li').forEach(li=>{if(+li.dataset.day===d)li.classList.add('today')});
</script>
</body>
</html>

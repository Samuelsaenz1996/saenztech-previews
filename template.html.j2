{#- Saenztech multi-page mockup template. Rendered once per page; `page` is the page id, `root` is the path back to the site root. -#}
{% macro L(v) -%}
{%- if v is mapping -%}
{%- if bilingual -%}<span data-es>{{ v.es|safe }}</span><span data-en>{{ v.en|safe }}</span>{%- else -%}{{ v[lang]|safe }}{%- endif -%}
{%- else -%}{{ v|safe }}{%- endif -%}
{%- endmacro %}
{% macro A(v) -%}{%- if v is mapping -%}{{ v[lang] }}{%- else -%}{{ v or '' }}{%- endif -%}{%- endmacro %}
{% macro icon(name) -%}
{%- if name=='phone' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
{%- elif name=='pin' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>
{%- elif name=='cal' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></svg>
{%- elif name=='clock' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
{%- elif name=='star' -%}<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z"/></svg>
{%- elif name=='mail' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
{%- elif name=='bag' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14l-1 13H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
{%- elif name=='doc' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h9l5 5v15H6z"/><path d="M14 2v6h6M9 13h8M9 17h6"/></svg>
{%- elif name=='arrow' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
{%- elif name=='check' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
{%- elif name=='area' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3z"/><path d="M9 3v15M15 6v15"/></svg>
{%- elif name=='facebook' -%}<svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H8v3h2.5V21z"/></svg>
{%- elif name=='instagram' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg>
{%- elif name=='tiktok' -%}<svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.6 3c.3 2 1.6 3.4 3.6 3.6v3a7 7 0 0 1-3.6-1.1v6.3a5.7 5.7 0 1 1-5.7-5.7h.6v3.1a2.7 2.7 0 1 0 2 2.6V3z"/></svg>
{%- elif name=='yelp' or name=='google' -%}<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z"/></svg>
{%- endif -%}
{%- endmacro %}
{% macro photo(p, cls='') -%}
<figure class="ph {{ cls }}"><img src="{{ root }}{{ p.path }}" alt="{{ A(p.alt) }}" loading="lazy">{% if p.sample %}<figcaption class="sample">{{ L(th.labels.sample_photo) }}</figcaption>{% endif %}</figure>
{%- endmacro %}
{% macro primary_btn(cls='primary') -%}
<a class="btn {{ cls }}" href="{{ (root ~ primary.href) if primary.internal else primary.href }}"{% if primary.ext %} target="_blank" rel="noopener"{% endif %}>{{ icon(primary.icon) }}{{ L(primary.label) }}</a>
{%- endmacro %}
{% set cur = (pages|selectattr('id','equalto',page)|first) %}
{% set items_page = (pages|selectattr('id','equalto','items')|first) %}
{% set gal_page = (pages|selectattr('id','equalto','gallery')|first) %}
{% set has_visit = (pages|selectattr('id','equalto','visit')|list|length) > 0 %}
<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{% if page != 'home' %}{{ A(cur.label) }} · {% endif %}{{ b.business }} — {{ t('Concepto de diseño','Design concept') }}</title>
<meta property="og:title" content="{{ b.business }} — {{ t('Concepto de diseño por Saenztech','Design concept by Saenztech') }}">
<meta property="og:image" content="{{ root }}preview.png">
<style>
{{ fontfaces|safe }}
:root{ {% for k,v in th.colors.items() %}--{{k}}:{{v}};{% endfor %}--r:{{ th.radius }};--shadow:0 1px 2px rgba(20,16,12,.06),0 8px 28px rgba(20,16,12,.08)}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:"{{ th.body_font }}",system-ui,sans-serif;color:var(--ink);background:var(--bg);line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
h1,h2,h3,.logo-name{font-family:"{{ th.head_font }}","{{ th.body_font }}",serif;line-height:1.08;letter-spacing:{{ th.tracking }};font-weight:{{ th.head_weight }}}
a{color:inherit;text-decoration:none}
img{display:block;max-width:100%}
.wrap{max-width:1160px;margin:0 auto;padding:0 20px}
.ribbon{background:var(--ink);color:var(--bg);font-size:12px;text-align:center;padding:6px 16px;opacity:.97}
.ribbon b{color:var(--accent2);font-weight:600}
.deco{height:{{ '22px' if th.deco=='picado' else '4px' }};display:flex;gap:{{ '3px' if th.deco=='picado' else '0' }}}
.deco span{flex:1}
{% if th.deco=='picado' %}.deco span{clip-path:polygon(0 0,100% 0,100% 72%,85% 100%,70% 72%,50% 100%,30% 72%,15% 100%,0 72%);-webkit-mask:radial-gradient(circle at 50% 38%,transparent 3px,#000 4px);mask:radial-gradient(circle at 50% 38%,transparent 3px,#000 4px)}{% endif %}
.deco span:nth-child(4n+1){background:var(--accent)}.deco span:nth-child(4n+2){background:var(--accent2)}.deco span:nth-child(4n+3){background:var(--accent3)}.deco span:nth-child(4n+4){background:var(--accent4)}
/* header */
.top{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:saturate(1.4) blur(10px);-webkit-backdrop-filter:saturate(1.4) blur(10px);border-bottom:1px solid var(--line)}
.bar{display:flex;align-items:center;gap:14px;height:68px}
.logo{display:flex;align-items:center;gap:10px;min-width:0;margin-right:auto}
.mono{flex:none;width:40px;height:40px;border-radius:{{ '50%' if th.radius=='999px' else '11px' }};background:var(--accent);color:#fff;display:grid;place-items:center;font:{{ th.head_weight }} 16px "{{ th.head_font }}",sans-serif;letter-spacing:.02em;box-shadow:inset 0 -3px 0 rgba(0,0,0,.18)}
.logo-name{font-size:19px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block}
.logo small{display:block;font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.logo>div{min-width:0}
.links{display:none;gap:4px}
.links a{padding:8px 12px;border-radius:999px;font-weight:500;font-size:15px;color:var(--muted)}
.links a:hover{color:var(--ink);background:var(--card)}
.links a.on{color:var(--ink);background:var(--card);box-shadow:inset 0 0 0 1px var(--line)}
.lang{display:flex;border:1.5px solid var(--ink);border-radius:999px;overflow:hidden;flex:none}
.lang button{border:0;background:transparent;font:600 12px "{{ th.body_font }}",sans-serif;padding:6px 10px;cursor:pointer;color:var(--ink)}
.lang button.on{background:var(--ink);color:var(--bg)}
.bar .btn,.bar .lang{display:none}
.lang.m{display:inline-flex;margin:4px 0 8px}.lang.m button{padding:8px 16px;font-size:13px}
.burger{flex:none;width:42px;height:42px;border:1.5px solid var(--line);background:var(--card);border-radius:12px;display:grid;place-items:center;cursor:pointer}
.burger span{display:block;width:18px;height:2px;background:var(--ink);box-shadow:0 -6px 0 var(--ink),0 6px 0 var(--ink)}
.drawer{display:none;border-top:1px solid var(--line);padding:10px 0 18px}
.drawer.open{display:block}
.drawer a{display:flex;justify-content:space-between;align-items:center;padding:14px 4px;border-bottom:1px solid var(--line);font-weight:600;font-size:17px}
.drawer a.on{color:var(--accent)}
.drawer a svg{width:18px;height:18px;flex:none}
.drawer .btn{display:flex;margin-top:14px;justify-content:center}
/* buttons */
.btn{display:inline-flex;align-items:center;gap:9px;font-weight:600;font-size:15.5px;padding:13px 20px;border-radius:var(--r);border:2px solid var(--ink);line-height:1.2;white-space:nowrap;transition:transform .15s}
.btn:hover{transform:translateY(-1px)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff;box-shadow:0 3px 0 var(--accent-dark)}
.btn.ghost{background:var(--card)}
.btn.light{background:#fff;border-color:#fff;color:var(--ink)}
.btn.outline-light{border-color:rgba(255,255,255,.6);color:#fff;background:rgba(255,255,255,.06);position:relative;z-index:1}
.btn svg{width:18px;height:18px;flex:none}
/* hero */
.hero{display:grid;gap:30px;padding:30px 0 48px;align-items:center}
.eyebrow{display:inline-flex;gap:8px;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:999px;padding:6px 13px;font-size:13px;font-weight:600}
.dot{width:8px;height:8px;border-radius:50%;background:var(--accent3);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent3) 25%,transparent)}
.hero h1{font-size:clamp(40px,8vw,76px);margin:16px 0 14px}
.hero h1 em,.sub-hero h1 em{font-style:{{ th.em_style }};color:var(--accent)}
.lead{font-size:18px;color:var(--muted);max-width:32em}
.ctas{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}
.rating{display:flex;align-items:center;gap:10px;margin-top:22px;font-size:14px;color:var(--muted)}
.stars{display:flex;color:var(--star,var(--accent2))}.stars svg{width:17px;height:17px}
.visual{position:relative}
.ph{position:relative;border-radius:22px;overflow:hidden;background:var(--ph1);margin:0}
.ph img{width:100%;height:100%;object-fit:cover}
.ph .sample{position:absolute;left:10px;bottom:10px;background:rgba(0,0,0,.55);color:#fff;font-size:11px;font-weight:500;padding:4px 9px;border-radius:999px;backdrop-filter:blur(4px)}
.visual .ph{aspect-ratio:4/3.4;box-shadow:var(--shadow)}
.visual .ph .sample{left:auto;right:10px}
.art{aspect-ratio:4/3.4;border-radius:24px;position:relative;overflow:hidden;background:
 radial-gradient(circle at 18% 22%,color-mix(in srgb,var(--accent2) 70%,transparent) 0 14%,transparent 14.5%),
 radial-gradient(circle at 86% 78%,color-mix(in srgb,var(--accent3) 75%,transparent) 0 20%,transparent 20.5%),
 radial-gradient(circle at 92% 12%,color-mix(in srgb,var(--accent4) 60%,transparent) 0 9%,transparent 9.5%),
 linear-gradient(135deg,var(--accent) 0%,var(--accent-dark) 100%);box-shadow:var(--shadow)}
.art::after{content:"";position:absolute;inset:0;background:repeating-linear-gradient(45deg,rgba(255,255,255,.06) 0 2px,transparent 2px 14px)}
.art .big{position:absolute;inset:0;display:grid;place-items:center;color:rgba(255,255,255,.95);font:{{ th.head_weight }} clamp(90px,22vw,170px)/1 "{{ th.head_font }}",sans-serif;letter-spacing:-.03em;text-shadow:0 6px 30px rgba(0,0,0,.25);z-index:1}
.sign{text-align:center;padding:0 12%;display:grid;gap:14px;justify-items:center}
.sn{font-size:clamp(28px,5.6vw,58px);line-height:1;letter-spacing:-.02em;text-wrap:balance}
.ss{font:600 12px "{{ th.body_font }}",sans-serif;letter-spacing:.18em;text-transform:uppercase;text-shadow:none;background:rgba(0,0,0,.22);padding:7px 13px;border-radius:999px;max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.float{position:absolute;z-index:2;background:var(--card);border-radius:16px;padding:12px 15px;box-shadow:0 10px 30px rgba(0,0,0,.18);display:flex;gap:11px;align-items:center;font-size:13.5px;max-width:78%}
.float b{display:block;font-size:15px;line-height:1.25}
.float small{color:var(--muted);display:block;line-height:1.3}
.float .ic{flex:none;width:36px;height:36px;border-radius:10px;display:grid;place-items:center;background:color-mix(in srgb,var(--accent) 12%,#fff);color:var(--accent)}
.float .ic svg{width:19px;height:19px}
.float.f1{left:-6px;bottom:22px}.float.f2{right:-6px;top:20px}
@media (max-width:899px){.visual{margin:14px 0 18px}.float{padding:9px 12px;font-size:12.5px}.float b{font-size:14px}.float .ic{width:30px;height:30px}.float.f1{left:10px;bottom:-16px}.float.f2{right:10px;top:-16px}.sign{padding:0 8%}}
/* sections */
section{padding:60px 0}
.kicker{display:inline-block;font-size:12.5px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin-bottom:10px}
.sec-head{display:flex;justify-content:space-between;align-items:end;gap:18px;margin-bottom:28px;flex-wrap:wrap}
.sec-head h2{font-size:clamp(30px,5vw,46px)}
.sec-head p{color:var(--muted);max-width:30em}
.more{display:inline-flex;align-items:center;gap:6px;font-weight:600;color:var(--accent)}
.more svg{width:17px;height:17px}
.strip{display:grid;gap:12px;margin-top:-10px}
.hl{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:16px 18px;display:flex;gap:14px;align-items:center}
.hl .ic{flex:none;width:44px;height:44px;border-radius:12px;display:grid;place-items:center;background:color-mix(in srgb,var(--accent) 11%,var(--card));color:var(--accent)}
.hl .ic svg{width:21px;height:21px}
.hl b{display:block;font-size:15.5px;line-height:1.3}
.hl small{color:var(--muted);font-size:13.5px;line-height:1.35;display:block}
.cards{display:grid;gap:16px}
.card-i{background:var(--card);border:1px solid var(--line);border-radius:20px;overflow:hidden;display:flex;flex-direction:column}
.card-i .ph{border-radius:0;aspect-ratio:16/10}
.card-i .body{padding:18px 20px 20px;display:flex;flex-direction:column;gap:6px;flex:1}
.card-i h3{font-size:22px}
.card-i p{color:var(--muted);font-size:15px}
.card-i .num{width:38px;height:38px;border-radius:11px;background:color-mix(in srgb,var(--accent) 12%,var(--card));color:var(--accent);display:grid;place-items:center;font-weight:700;margin-bottom:6px}
.price{font-weight:700;color:var(--accent);font-size:15px}
.menu-group{margin-bottom:38px}
.menu-group h3.gt{font-size:26px;margin-bottom:14px;display:flex;align-items:center;gap:12px}
.menu-group h3.gt::after{content:"";flex:1;height:2px;background:var(--line)}
.rows{display:grid;gap:12px}
.row{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px 18px;display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:center}
.row .ph{width:72px;height:72px;border-radius:12px}
.row h4{font:600 17.5px "{{ th.body_font }}",sans-serif}
.row p{color:var(--muted);font-size:14.5px;margin-top:2px}
.row.noimg{grid-template-columns:1fr auto}
.row.placeholder{background:transparent;border-style:dashed}
.row.placeholder h4{color:var(--ph-ink)}
.band{background:var(--band);color:#fff;position:relative;overflow:hidden}
.band::before{content:"";position:absolute;right:-80px;top:-80px;width:260px;height:260px;border-radius:50%;background:rgba(255,255,255,.07)}
.band .wrap{display:grid;gap:22px;position:relative}
.band h2{font-size:clamp(28px,4.5vw,40px)}
.chips{display:flex;flex-wrap:wrap;gap:10px}
.chip{background:rgba(255,255,255,.13);border:1px solid rgba(255,255,255,.32);border-radius:999px;padding:9px 15px;font-weight:500;display:inline-flex;gap:8px;align-items:center}
.chip svg{width:16px;height:16px;color:var(--accent2)}
.band small{opacity:.85;font-size:13px}
.grid-g{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.grid-g .ph{aspect-ratio:1;border-radius:16px}
.grid-g .ph:first-child{grid-column:span 2;aspect-ratio:16/9}
.cta{padding:0 0 70px}
.band + .cta{padding-top:60px}
.cta-box{background:var(--ink);color:var(--bg);border-radius:28px;padding:36px 26px;display:grid;gap:18px;position:relative;overflow:hidden}
.cta-box::after{content:"";position:absolute;width:220px;height:220px;border-radius:50%;right:-60px;bottom:-90px;background:var(--accent);opacity:.9}
.cta-box h2{font-size:clamp(30px,5vw,44px);position:relative;z-index:1}
.cta-box p{opacity:.8;position:relative;z-index:1}
.cta-box .ctas{margin-top:4px;position:relative;z-index:1}
.sub-hero{padding:46px 0 34px;border-bottom:1px solid var(--line);background:linear-gradient(180deg,color-mix(in srgb,var(--accent) 6%,var(--bg)),var(--bg))}
.crumb{font-size:13px;color:var(--muted);margin-bottom:10px}
.crumb a{text-decoration:underline;text-underline-offset:3px}
.sub-hero h1{font-size:clamp(38px,7vw,64px)}
.sub-hero p{color:var(--muted);font-size:17.5px;margin-top:12px;max-width:34em}
.info{display:grid;gap:16px}
.card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:24px}
.card h3{font-size:23px;margin-bottom:14px}
.hours{list-style:none}
.hours li{display:flex;justify-content:space-between;gap:12px;padding:11px 0;border-bottom:1px solid var(--line)}
.hours li:last-child{border:0}
.hours li.today{font-weight:700;color:var(--accent)}
.note{font-size:12.5px;color:var(--muted);margin-top:10px}
.mapbox{position:relative;border-radius:16px;overflow:hidden;aspect-ratio:16/10;background:
 linear-gradient(90deg,transparent 48%,var(--line) 48% 52%,transparent 52%),linear-gradient(0deg,transparent 46%,var(--line) 46% 54%,transparent 54%),linear-gradient(30deg,transparent 60%,var(--ph1) 60% 63%,transparent 63%),var(--bg);margin-top:14px;display:grid;place-items:center}
.mapbox.wide{aspect-ratio:21/9;margin-top:16px}
@media (max-width:639px){.mapbox.wide{aspect-ratio:4/3}}
.mapbox iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.pin{background:var(--accent);color:#fff;font-weight:600;font-size:13px;padding:8px 12px;border-radius:12px;box-shadow:0 6px 16px rgba(0,0,0,.15)}
.clist{list-style:none;display:grid;gap:4px}
.clist li{display:flex;gap:13px;align-items:flex-start;padding:12px 0;border-bottom:1px solid var(--line)}
.clist li:last-child{border:0}
.clist .ic{flex:none;width:40px;height:40px;border-radius:11px;display:grid;place-items:center;background:color-mix(in srgb,var(--accent) 11%,var(--card));color:var(--accent)}
.clist .ic svg{width:19px;height:19px}
.clist small{display:block;color:var(--muted);font-size:12.5px;text-transform:uppercase;letter-spacing:.08em;font-weight:600}
.clist a,.clist span{font-weight:600;word-break:break-word}
.social{display:flex;gap:10px;flex-wrap:wrap}
.social a{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;background:var(--bg);border:1px solid var(--line)}
.social a svg{width:20px;height:20px}
form{display:grid;gap:14px}
label{display:grid;gap:6px;font-weight:600;font-size:14px}
input,textarea,select{font:inherit;font-weight:400;padding:13px 14px;border:1.5px solid var(--line);border-radius:12px;background:var(--bg);color:var(--ink);width:100%}
input:focus,textarea:focus,select:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 18%,transparent)}
textarea{min-height:120px;resize:vertical}
.two{display:grid;gap:14px}
form .btn{justify-content:center;cursor:pointer;font-family:inherit}
.ok{display:none;background:color-mix(in srgb,var(--accent3) 12%,var(--card));border:1px solid color-mix(in srgb,var(--accent3) 40%,var(--card));border-radius:12px;padding:12px 14px;font-size:14px}
.ok.show{display:block}
.about p{font-size:17px;margin-bottom:14px}
.gal{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.gal .ph{aspect-ratio:1;border-radius:14px}
.gal.g4{grid-template-columns:repeat(2,1fr)}
@media (min-width:900px){.gal.g4{grid-template-columns:repeat(4,1fr)}}
.gal .ph.wide{grid-column:span 2;aspect-ratio:16/9}
footer{background:var(--ink);color:var(--bg);padding:50px 0 96px;font-size:14.5px}
footer .cols{display:grid;gap:30px}
footer h4{font-size:12.5px;letter-spacing:.14em;text-transform:uppercase;opacity:.6;margin-bottom:12px;font-weight:600}
footer .logo-name{font-size:24px;color:#fff;white-space:normal}
footer .cols>*{min-width:0}
footer p,footer li{opacity:.85}
footer ul{list-style:none;display:grid;gap:8px}
footer a:hover{text-decoration:underline}
footer .social a{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.15);color:#fff}
footer .concept{border-top:1px solid rgba(255,255,255,.14);margin-top:34px;padding-top:18px;font-size:12.5px;opacity:.65}
.callbar{position:fixed;left:12px;right:12px;bottom:12px;display:flex;gap:10px;z-index:15}
.callbar .btn{flex:1;justify-content:center;box-shadow:0 8px 24px rgba(0,0,0,.18)}
@media (min-width:640px){.strip{grid-template-columns:repeat(3,1fr)}.two{grid-template-columns:1fr 1fr}.gal{grid-template-columns:repeat(3,1fr)}.cards{grid-template-columns:repeat(2,1fr)}}
@media (min-width:900px){
 .links{display:flex}.burger{display:none}.bar .lang{display:flex}.bar .btn{display:inline-flex;padding:10px 16px;font-size:14.5px}.drawer{display:none!important}
 .hero{grid-template-columns:1.05fr .95fr;padding:56px 0 70px}
 .cards{grid-template-columns:repeat(3,1fr)}
 .band .wrap{grid-template-columns:1fr 1.25fr;align-items:center}
 .info{grid-template-columns:1fr 1fr}
 .info.contact{grid-template-columns:.85fr 1.15fr}
 .grid-g{grid-template-columns:2fr 1fr 1fr;grid-template-rows:1fr 1fr}
 .grid-g .ph:first-child{grid-row:span 2;grid-column:auto;aspect-ratio:auto}
 .cta-box{padding:54px;grid-template-columns:1.3fr 1fr;align-items:center}
 .callbar{display:none}
 footer{padding-bottom:40px}
 footer .cols{grid-template-columns:1.4fr 1fr 1fr 1fr}
 .rows.twocol{grid-template-columns:1fr 1fr}
}
{% if bilingual %}
[data-{{ alt }}]{display:none!important}
html[lang={{ alt }}] [data-{{ lang }}]{display:none!important}
html[lang={{ alt }}] [data-{{ alt }}]{display:revert!important}
{% endif %}
</style>
</head>
<body>
<div class="ribbon">{{ L({'es':'<b>Concepto de diseño</b> por Saenztech · no es el sitio oficial de '~bn,'en':'<b>Design concept</b> by Saenztech · not the official site of '~bn}) }}</div>
<div class="deco" aria-hidden="true">{% for i in range(24) %}<span></span>{% endfor %}</div>

<header class="top">
 <div class="wrap">
  <div class="bar">
   <a class="logo" href="{{ root or './' }}"><span class="mono">{{ initials }}</span><div><span class="logo-name">{{ b.business }}</span><small>{{ L(b.subtitle) }}</small></div></a>
   <nav class="links" aria-label="Main">{% for p in pages %}<a href="{{ root }}{{ p.dir }}" class="{{ 'on' if p.id==page }}">{{ L(p.label) }}</a>{% endfor %}</nav>
   {% if bilingual %}<div class="lang" role="group" aria-label="Idioma / Language"><button class="{{ 'on' if lang=='es' }}" data-set="es">ES</button><button class="{{ 'on' if lang=='en' }}" data-set="en">EN</button></div>{% endif %}
   {{ primary_btn() }}
   <button class="burger" aria-label="{{ A(th.labels.menu_toggle) }}" aria-expanded="false"><span></span></button>
  </div>
  <div class="drawer">{% if bilingual %}<div class="lang m" role="group" aria-label="Idioma / Language"><button class="{{ 'on' if lang=='es' }}" data-set="es">Español</button><button class="{{ 'on' if lang=='en' }}" data-set="en">English</button></div>{% endif %}{% for p in pages %}<a href="{{ root }}{{ p.dir }}" class="{{ 'on' if p.id==page }}">{{ L(p.label) }}{{ icon('arrow') }}</a>{% endfor %}{{ primary_btn() }}</div>
 </div>
</header>

<main>
{% if page == 'home' %}
 <div class="wrap">
  <div class="hero">
   <div>
    {% if b.eyebrow %}<span class="eyebrow"><span class="dot"></span>{{ L(b.eyebrow) }}</span>{% endif %}
    <h1>{{ L(b.headline) }}</h1>
    <p class="lead">{{ L(b.lead) }}</p>
    <div class="ctas">
     {{ primary_btn() }}
     <a class="btn ghost" href="{{ root }}{{ items_page.dir }}/">{{ L(items_page.label) }}{{ icon('arrow') }}</a>
    </div>
    {% if b.rating %}<div class="rating"><span class="stars">{% for i in range(5) %}{{ icon('star') }}{% endfor %}</span>{{ L({'es': '<b>' ~ b.rating.value ~ '</b> · ' ~ b.rating.count ~ ' reseñas en ' ~ b.rating.source, 'en': '<b>' ~ b.rating.value ~ '</b> · ' ~ b.rating.count ~ ' reviews on ' ~ b.rating.source}) }}</div>{% endif %}
   </div>
   <div class="visual">
    {% if hero_photo %}{{ photo(hero_photo) }}{% else %}<div class="art" aria-hidden="true"><div class="big"><div class="sign"><span class="sn">{{ b.business }}</span><span class="ss">{{ A(b.subtitle) }}</span></div></div></div>{% endif %}
    {% if b.hours %}<div class="float f1"><span class="ic">{{ icon('clock') }}</span><div><small>{{ L(th.labels.open_today) }}</small><b class="today-hours" data-closed="{{ A(th.labels.closed_today) }}">{{ b.hours[0].time }}</b></div></div>
    {% elif b.service_area %}<div class="float f1"><span class="ic">{{ icon('area') }}</span><div><small>{{ L(th.labels.service_area_t) }}</small><b>{{ L(b.service_area) }}</b></div></div>{% endif %}
    {% if b.rating %}<div class="float f2"><span class="ic">{{ icon('star') }}</span><div><b>{{ b.rating.value }} / 5</b><small>{{ b.rating.source }}</small></div></div>
    {% elif items %}<div class="float f2"><span class="ic">{{ icon('check') }}</span><div><small>{{ L(th.labels.items_nav) }}</small><b>{{ L(items[0].name) }}</b></div></div>{% endif %}
   </div>
  </div>
  <div class="strip">
   {% if b.address %}<a class="hl" href="{{ maps }}" target="_blank" rel="noopener"><span class="ic">{{ icon('pin') }}</span><div><b>{{ b.address.split(',')[0] }}</b><small>{{ b.city }} · {{ L(th.labels.directions) }}</small></div></a>
   {% elif b.service_area %}<div class="hl"><span class="ic">{{ icon('area') }}</span><div><b>{{ L(th.labels.service_area_t) }}</b><small>{{ L(b.service_area) }}</small></div></div>{% endif %}
   {% if b.hours %}<a class="hl" href="{{ root }}{{ 'visit/' if has_visit else 'contact/' }}"><span class="ic">{{ icon('clock') }}</span><div><b>{{ L(th.labels.hours_short) }}</b><small>{{ b.hours|map(attribute='time')|unique|list|length == 1 and (b.hours|length ~ ' ' ~ t('días','days') ~ ' · ' ~ b.hours[0].time) or t('Ver horario completo','See full hours') }}</small></div></a>{% endif %}
   {% if b.phone %}<a class="hl" href="tel:{{ b.phone }}"><span class="ic">{{ icon('phone') }}</span><div><b>{{ b.phone_display }}</b><small>{{ L(th.labels.call_us) }}</small></div></a>{% endif %}
   {% if not b.hours and b.email %}<a class="hl" href="mailto:{{ b.email }}"><span class="ic">{{ icon('mail') }}</span><div><b>{{ L(th.labels.write_us) }}</b><small>{{ b.email }}</small></div></a>{% endif %}
  </div>
 </div>

 <section>
  <div class="wrap">
   <div class="sec-head"><div><span class="kicker">{{ L(th.labels.items_nav) }}</span><h2>{{ L(b.items_title or th.labels.items_title) }}</h2></div><a class="more" href="{{ root }}{{ items_page.dir }}/">{{ L(th.labels.see_all) }} {{ icon('arrow') }}</a></div>
   <div class="cards">
    {% set home_photos = (items[:3]|selectattr('photo_path')|list|length) == (items[:3]|length) %}{% for it in items[:3] %}
    <article class="card-i">
     {% if home_photos %}{{ photo({'path': it.photo_path, 'alt': it.name, 'sample': it.photo_sample}) }}{% endif %}
     <div class="body">{% if not home_photos %}<span class="num">{{ loop.index }}</span>{% endif %}<h3>{{ L(it.name) }}</h3>{% if it.desc %}<p>{{ L(it.desc) }}</p>{% endif %}{% if th.show_price and it.price %}<div class="price">{{ it.price }}</div>{% endif %}</div>
    </article>
    {% endfor %}
   </div>
  </div>
 </section>

 {% if b.themes %}
 <section class="band">
  <div class="wrap">
   <div><span class="kicker" style="color:var(--accent2)">{{ L(th.labels.highlights) }}</span><h2>{{ L(th.labels.reviews_title) }}</h2><small>{{ L(th.labels.reviews_note) }}</small></div>
   <div class="chips">{% for c in b.themes %}<span class="chip">{{ icon('check') }}{{ L(c) }}</span>{% endfor %}</div>
  </div>
 </section>
 {% endif %}

 {% if gal_page %}
 <section>
  <div class="wrap">
   <div class="sec-head"><div><span class="kicker">{{ L(gal_page.label) }}</span><h2>{{ L(gal_page.label) }}</h2></div><a class="more" href="{{ root }}{{ gal_page.dir }}/">{{ L(th.labels.see_all) }} {{ icon('arrow') }}</a></div>
   {% if gallery|length >= 5 %}<div class="grid-g">{% for p in gallery[:5] %}{{ photo(p) }}{% endfor %}</div>{% else %}<div class="gal g4">{% for p in gallery[:4] %}{{ photo(p) }}{% endfor %}</div>{% endif %}
  </div>
 </section>
 {% endif %}

{% elif page == 'items' %}
 <div class="sub-hero"><div class="wrap"><div class="crumb"><a href="{{ root }}">{{ L(th.labels.nav_home) }}</a> / {{ L(cur.label) }}</div><h1>{{ L(b.items_title or th.labels.items_title) }}</h1><p>{{ L(b.items_note or th.labels.items_note) }}</p></div></div>
 <section>
  <div class="wrap">
   {% for g in groups %}
   <div class="menu-group">
    {% if g.name %}<h3 class="gt">{{ L(g.name) }}</h3>{% endif %}
    <div class="rows {{ 'twocol' if g['items']|length > 3 }}">
     {% for it in g['items'] %}
     <div class="row {{ '' if it.photo_path else 'noimg' }}">{% if it.photo_path %}{{ photo({'path': it.photo_path, 'alt': it.name}) }}{% endif %}<div><h4>{{ L(it.name) }}</h4>{% if it.desc %}<p>{{ L(it.desc) }}</p>{% endif %}</div>{% if th.show_price %}<span class="price">{{ it.price or '' }}</span>{% else %}<span></span>{% endif %}</div>
     {% endfor %}
    </div>
   </div>
   {% endfor %}
   {% if placeholders %}
   <div class="rows">{% for ph in placeholders %}<div class="row noimg placeholder"><div><h4>{{ L(ph.name) }}</h4><p>{{ L(ph.desc) }}</p></div><span></span></div>{% endfor %}</div>
   {% endif %}
  </div>
 </section>

{% elif page == 'gallery' %}
 <div class="sub-hero"><div class="wrap"><div class="crumb"><a href="{{ root }}">{{ L(th.labels.nav_home) }}</a> / {{ L(cur.label) }}</div><h1>{{ L(cur.label) }}</h1>{% if stock_used %}<p>{{ L(th.labels.sample_note) }}</p>{% endif %}</div></div>
 <section>
  <div class="wrap"><div class="gal">{% for p in gallery %}{{ photo(p, 'wide' if loop.index0 % 5 == 0 else '') }}{% endfor %}</div></div>
 </section>

{% elif page == 'about' %}
 <div class="sub-hero"><div class="wrap"><div class="crumb"><a href="{{ root }}">{{ L(th.labels.nav_home) }}</a> / {{ L(cur.label) }}</div><h1>{{ L(th.labels.about_title) }}</h1></div></div>
 <section>
  <div class="wrap info">
   <div class="about">{% for para in (b.about if b.about is sequence and b.about is not string and b.about is not mapping else [b.about]) %}<p>{{ L(para) }}</p>{% endfor %}
    {% if b.themes %}<div class="chips" style="margin-top:18px">{% for c in b.themes %}<span class="chip" style="background:var(--card);border-color:var(--line);color:var(--ink)">{{ icon('check') }}{{ L(c) }}</span>{% endfor %}</div>{% endif %}
   </div>
   <div>{% if gallery %}{{ photo(gallery[0]) }}{% elif hero_photo %}{{ photo(hero_photo) }}{% else %}<div class="art"><div class="big"><div class="sign"><span class="sn">{{ b.business }}</span><span class="ss">{{ A(b.subtitle) }}</span></div></div></div>{% endif %}</div>
  </div>
 </section>

{% elif page == 'visit' %}
 <div class="sub-hero"><div class="wrap"><div class="crumb"><a href="{{ root }}">{{ L(th.labels.nav_home) }}</a> / {{ L(cur.label) }}</div><h1>{{ L(cur.label) }}</h1>{% if b.address %}<p>{{ b.address }}</p>{% endif %}</div></div>
 <section>
  <div class="wrap info">
   {% if b.hours %}<div class="card"><h3>{{ L(th.labels.hours) }}</h3><ul class="hours">{% for h in b.hours %}<li data-day="{{ h.day }}"><span>{{ L({'es':h.es,'en':h.en}) }}</span><span>{{ h.time }}</span></li>{% endfor %}</ul><p class="note">{{ L(th.labels.hours_note) }}</p></div>{% endif %}
   <div class="card"><h3>{{ L(th.labels.find_us) }}</h3>
    {% if b.address %}<p>{{ b.address }}</p>
    <div class="mapbox"><span class="pin">{{ b.business }}</span><iframe src="{{ embed }}" loading="lazy" title="Map" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
    <div class="ctas"><a class="btn primary" href="{{ maps }}" target="_blank" rel="noopener">{{ icon('pin') }}{{ L(th.labels.directions_long) }}</a>{% if b.phone %}<a class="btn ghost" href="tel:{{ b.phone }}">{{ icon('phone') }}{{ b.phone_display }}</a>{% endif %}</div>
    {% else %}<p>{{ L(b.service_area or {'es':'Área de servicio por confirmar','en':'Service area to be confirmed'}) }}</p>{% endif %}
   </div>
  </div>
 </section>

{% elif page == 'contact' %}
 <div class="sub-hero"><div class="wrap"><div class="crumb"><a href="{{ root }}">{{ L(th.labels.nav_home) }}</a> / {{ L(cur.label) }}</div><h1>{{ L(th.labels.cta_title) }}</h1><p>{{ L(th.labels.cta_text) }}</p></div></div>
 <section>
  <div class="wrap info contact">
   <div class="card">
    <h3>{{ L(th.labels.contact) }}</h3>
    <ul class="clist">
     {% if b.phone %}<li><span class="ic">{{ icon('phone') }}</span><div><small>{{ L(th.labels.phone_t) }}</small><a href="tel:{{ b.phone }}">{{ b.phone_display }}</a></div></li>{% endif %}
     {% if b.email %}<li><span class="ic">{{ icon('mail') }}</span><div><small>{{ L(th.labels.email_t) }}</small><a href="mailto:{{ b.email }}">{{ b.email }}</a></div></li>{% endif %}
     {% if b.address %}<li><span class="ic">{{ icon('pin') }}</span><div><small>{{ L(th.labels.address) }}</small><a href="{{ maps }}" target="_blank" rel="noopener">{{ b.address }}</a></div></li>
     {% elif b.service_area %}<li><span class="ic">{{ icon('area') }}</span><div><small>{{ L(th.labels.service_area_t) }}</small><span>{{ L(b.service_area) }}</span></div></li>{% endif %}
     {% if b.booking_url %}<li><span class="ic">{{ icon('cal') }}</span><div><small>{{ L(th.labels.book) }}</small><a href="{{ b.booking_url }}" target="_blank" rel="noopener">{{ L(b.booking_label or th.labels.book) }} →</a></div></li>{% endif %}
     {% if b.order_url %}<li><span class="ic">{{ icon('bag') }}</span><div><small>{{ L(th.labels.order) }}</small><a href="{{ b.order_url }}" target="_blank" rel="noopener">{{ L(b.order_label or th.labels.order) }} →</a></div></li>{% endif %}
    </ul>
    {% if b.hours and not has_visit %}<h3 style="margin-top:18px">{{ L(th.labels.hours) }}</h3><ul class="hours">{% for h in b.hours %}<li data-day="{{ h.day }}"><span>{{ L({'es':h.es,'en':h.en}) }}</span><span>{{ h.time }}</span></li>{% endfor %}</ul>{% endif %}
    {% if b.socials %}<h3 style="margin-top:18px">{{ L(th.labels.follow) }}</h3><div class="social">{% for k,v in b.socials.items() %}<a href="{{ v }}" target="_blank" rel="noopener" aria-label="{{ k }}">{{ icon(k) }}</a>{% endfor %}</div>{% endif %}
   </div>
   <div class="card">
    <h3>{{ L(th.labels.write_us) }}</h3>
    <form onsubmit="event.preventDefault();this.querySelector('.ok').classList.add('show')">
     <div class="two"><label>{{ L(th.labels.form_name) }}<input name="n" autocomplete="name"></label><label>{{ L(th.labels.form_phone) }}<input name="p" type="tel" autocomplete="tel"></label></div>
     <label>{{ L(th.labels.form_email) }}<input name="e" type="email" autocomplete="email"></label>
     {% if items and th.pages.quote %}<label>{{ L(th.labels.items_nav) }}<select name="s">{% for it in items %}<option>{{ A(it.name) }}</option>{% endfor %}<option>{{ t('Otro','Other') }}</option></select></label>{% endif %}
     <label>{{ L(th.labels.form_msg) }}<textarea name="m"></textarea></label>
     <button class="btn primary" type="submit">{{ icon('mail') }}{{ L(th.labels.form_send) }}</button>
     <div class="ok">{{ L(th.labels.form_demo) }}</div>
    </form>
   </div>
  </div>
  {% if b.address and not has_visit %}<div class="wrap"><div class="mapbox wide"><span class="pin">{{ b.business }}</span><iframe src="{{ embed }}" loading="lazy" title="Map" referrerpolicy="no-referrer-when-downgrade"></iframe></div></div>{% endif %}
 </section>
{% endif %}

{% if page != 'contact' %}
 <section class="cta">
  <div class="wrap"><div class="cta-box">
   <div><h2>{{ L(th.labels.cta_title) }}</h2>{% if (th.labels.cta_text.es if th.labels.cta_text is mapping else th.labels.cta_text) %}<p>{{ L(th.labels.cta_text) }}</p>{% endif %}</div>
   <div class="ctas">{{ primary_btn('light') }}{% if primary.icon != 'phone' and b.phone %}<a class="btn outline-light" href="tel:{{ b.phone }}">{{ icon('phone') }}{{ b.phone_display }}</a>{% elif not primary.internal %}<a class="btn outline-light" href="{{ root }}contact/">{{ L(th.labels.nav_contact) }}</a>{% elif b.email %}<a class="btn outline-light" href="mailto:{{ b.email }}">{{ icon('mail') }}{{ L(th.labels.write_us) }}</a>{% endif %}</div>
  </div></div>
 </section>
{% endif %}
</main>

<footer>
 <div class="wrap">
  <div class="cols">
   <div><span class="logo-name">{{ b.business }}</span><p style="margin-top:10px">{{ L(b.subtitle) }}</p>{% if b.socials %}<div class="social" style="margin-top:16px">{% for k,v in b.socials.items() %}<a href="{{ v }}" target="_blank" rel="noopener" aria-label="{{ k }}">{{ icon(k) }}</a>{% endfor %}</div>{% endif %}</div>
   <div><h4>{{ L(th.labels.pages) }}</h4><ul>{% for p in pages %}<li><a href="{{ root }}{{ p.dir }}">{{ L(p.label) }}</a></li>{% endfor %}</ul></div>
   <div><h4>{{ L(th.labels.contact) }}</h4><ul>{% if b.phone %}<li><a href="tel:{{ b.phone }}">{{ b.phone_display }}</a></li>{% endif %}{% if b.email %}<li><a href="mailto:{{ b.email }}">{{ b.email }}</a></li>{% endif %}<li>{% if b.address %}{{ b.address }}{% else %}{{ L(b.service_area) if b.service_area else b.city }}{% endif %}</li></ul></div>
   {% if b.hours %}<div><h4>{{ L(th.labels.hours) }}</h4><ul>{% for h in b.hours %}<li>{{ L({'es':h.es[:3],'en':h.en[:3]}) }} · {{ h.time }}</li>{% endfor %}</ul></div>{% endif %}
  </div>
  <div class="concept">{{ L({'es':'Este es un concepto de diseño preparado por Saenztech (saenz-tech.com) para mostrarle a '~bn~' cómo podría verse su sitio. No es el sitio oficial del negocio. Fotos, precios y textos se definen con el dueño.','en':'This is a design concept prepared by Saenztech (saenz-tech.com) to show '~bn~' what their site could look like. It is not the business\'s official site. Photos, prices and copy are finalized with the owner.'}) }}</div>
 </div>
</footer>

{% if b.phone or primary.ext %}
<div class="callbar">
 {% if primary.ext %}{{ primary_btn() }}{% endif %}
 {% if b.phone %}<a class="btn {{ 'ghost' if primary.ext else 'primary' }}" href="tel:{{ b.phone }}">{{ icon('phone') }}{{ L(th.labels.call) }}</a>{% endif %}
 {% if not primary.ext and page != 'contact' %}<a class="btn ghost" href="{{ root }}contact/">{{ L(th.labels.nav_contact) }}</a>{% endif %}
</div>
{% endif %}

<script>
(function(){
 var K='st-lang-{{ b.slug }}',h=document.documentElement;
 function set(l){h.lang=l;document.querySelectorAll('.lang button').forEach(function(x){x.classList.toggle('on',x.dataset.set===l)});try{localStorage.setItem(K,l)}catch(e){}}
 var q=new URLSearchParams(location.search).get('lang'),s=null;try{s=localStorage.getItem(K)}catch(e){}
 if(q==='es'||q==='en')set(q);else if(s==='es'||s==='en')set(s);
 document.querySelectorAll('.lang button').forEach(function(b){b.addEventListener('click',function(){set(b.dataset.set)})});
 var bg=document.querySelector('.burger'),dr=document.querySelector('.drawer');
 if(bg)bg.addEventListener('click',function(){var o=dr.classList.toggle('open');bg.setAttribute('aria-expanded',o)});
 var d=new Date().getDay();
 document.querySelectorAll('.hours li').forEach(function(li){if(+li.dataset.day===d)li.classList.add('today')});
 var hrs={{ (b.hours or [])|tojson }},th=document.querySelector('.today-hours');
 if(th){var m=hrs.filter(function(x){return x.day===d})[0];th.textContent=m?m.time:th.dataset.closed}
})();
</script>
</body>
</html>
